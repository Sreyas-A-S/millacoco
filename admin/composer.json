{
    "name": "millacoco/admin",
    "description": "Lightweight, secure, and fast admin panel for Millacoco",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.15.2",
        "slim/psr7": "^1.7.0",
        "firebase/php-jwt": "^6.10"
    },
    "autoload": {
        "psr-4": {
            "Millacoco\\Admin\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
